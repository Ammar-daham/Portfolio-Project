# EmailJS IDs for the contact form (src/components/ContactForm.jsx).
# Copy this file to .env (gitignored) and fill in the values from the
# EmailJS dashboard. On Netlify, set the same variables under
# Site configuration → Environment variables.
#
# Vite inlines VITE_* variables into the client bundle, so never put a real
# secret here. The EmailJS dashboard limits which origins may use these.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
