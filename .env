# EmailJS IDs for the contact form (src/components/ContactForm.jsx).
# They are public by design: Vite inlines them into the client bundle. The
# EmailJS dashboard limits which origins may use them. Put local overrides
# in .env.local (gitignored); variables set in Netlify take priority too.
VITE_EMAILJS_SERVICE_ID=service_ID_ammar
VITE_EMAILJS_TEMPLATE_ID=template_ID
VITE_EMAILJS_PUBLIC_KEY=B0Q-gtarwkqZhDpXo
